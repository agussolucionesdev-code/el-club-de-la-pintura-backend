// 1. Database Client Configuration
generator client {
  provider = "prisma-client-js"
}

// 2. Database Connection (PostgreSQL)
// Connection URL is configured in prisma.config.ts (Prisma v7 requirement)
datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// DATABASE MODELS (Multi-Branch Architecture & ERP)
// ------------------------------------------------------

// Manage physical branches and locations
model Branch {
  id       Int     @id @default(autoincrement())
  name     String
  location String?
  isActive Boolean @default(true)

  users     User[] // M:N: Employees assigned to this branch
  stocks    Stock[]
  /** Computadoras del mostrador asignadas a esta sucursal. */
  terminals Terminal[]
  movements Movement[]
  sales     Sale[]
  payments  Payment[] // Track physical money entering this branch

  // Track shifts in this branch
  cashRegisters CashRegister[]

  // NEW: Track daily operational expenses for this branch
  expenses Expense[]

  // NEW: Manual cash movements (ingreso/retiro) in this branch
  cashMovements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Manage system users, credentials and roles
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     String @default("EMPLOYEE")

  // Cloudinary URL of the profile photo. Null = fall back to the initial.
  avatarUrl String?

  branches Branch[] // M:N: Branches this user can operate in

  movements Movement[]
  /** Atribución legado: se conserva intacta por compatibilidad hacia atrás. */
  sales     Sale[]
  /** Ventas donde esta persona fue la VENDEDORA (de acá sale la comisión). */
  salesAsSeller  Sale[] @relation("SaleSeller")
  /** Ventas donde esta persona fue la CAJERA (de acá sale el arqueo). */
  salesAsCashier Sale[] @relation("SaleCashier")
  payments  Payment[] // Track which employee collected the money

  // Track shifts opened by this user
  cashRegisters CashRegister[]

  // NEW: Track which employee registered an expense
  expenses Expense[]

  // NEW: Manual cash movements registered by this user
  cashMovements CashMovement[]

  /** PIN para operar el POS. Lo tienen todos los que venden, incluido el dueño. */
  posPin         PosPinCredential?
  posActivations PosPinActivation[]
  posSessions    PosOperatorSession[]
  posDrafts      PosDraft[]

  /** Su cuenta en el libro del personal. La tiene sólo quien consumió alguna vez. */
  staffAccount StaffAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// APP SETTINGS
// ==========================================
// Business-wide switches the owner controls from Configuración.
// One row, always id = 1: these are settings for the shop, not per user, so a
// key/value bag would only trade type safety for nothing.
model AppSetting {
  id Int @id @default(1)

  // Whether an ENCARGADO may read the discount code. The owner may want to hand
  // it out personally; enforced server-side, not just hidden in the UI.
  discountCodeVisibleToEncargado Boolean @default(true)

  // How discount authorization works:
  //   "DAILY"    — one rotating code per branch per day (autonomous, default)
  //   "PER_SALE" — admin/encargado mints a single-use code on demand per sale
  discountCodeMode String @default("DAILY")

  // Sidebar alerts. Each can be silenced, and the noisy ones have a floor so a
  // single stale item does not badge the menu forever.
  alertCashEnabled     Boolean @default(true)
  alertStockEnabled    Boolean @default(true)
  alertStockMinCount   Int     @default(1) // badge only from N flagged products up
  alertAccountsEnabled Boolean @default(true)
  alertAccountsMinDebt Int     @default(0) // badge only past this total debt ($)
  alertPayrollEnabled  Boolean @default(true)

  // @default(now()) declara lo que la base YA tiene. No es cosmético: el DDL de
  // arranque (app.ts, ensureAppSettingTable) hace
  // `INSERT INTO "AppSetting" ("id") VALUES (1)` sin pasar updatedAt, y depende
  // de ese default. Sin declararlo acá, el schema y la base quedaban en deriva.
  updatedAt DateTime @updatedAt @default(now())
}

// Single-use discount codes for PER_SALE mode. Kept tiny on purpose: they
// expire fast and used/expired rows are swept on every generation, so the
// table never accumulates the "muchos códigos" the owner worried about.
model DiscountToken {
  id        Int      @id @default(autoincrement())
  code      String // 6-digit, shown to whoever authorizes the sale
  branchId  Int
  used      Boolean  @default(false)
  createdBy Int // user id that minted it, for the audit trail
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([branchId, code])
  @@index([expiresAt])
}

// ==========================================
// CUSTOMER & ACCOUNTS RECEIVABLE MODULE
// ==========================================
// Store client profiles, contractors, and companies
model Customer {
  id       Int     @id @default(autoincrement())
  name     String
  document String? @unique // DNI or CUIT
  type     String  @default("CONSUMER") // e.g., CONSUMER, CONTRACTOR, COMPANY, FAMILY
  phone    String?
  email    String?
  address  String?

  // Credit control fields
  creditLimit     Int @default(0) // Maximum allowed outstanding balance (0 = unlimited)
  defaultDiscount Int @default(0) // Automatic discount percentage applied in POS (0–100)

  // ==========================================
  // INYECCIÓN DE SEGURIDAD FISCAL (Soft Delete)
  // ==========================================
  isActive Boolean @default(true)

  sales Sale[] // Relate billing and debts to this specific customer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SUPPLIER MODULE (Proveedores)
// ==========================================
// Store supplier companies and contact representatives for WhatsApp orders
model Supplier {
  id          Int     @id @default(autoincrement())
  companyName String // Name of the company (e.g., Alba, Sherwin Williams)
  cuit        String? @unique
  contactName String? // Representative (e.g., "Juan Perez - Corredor")
  phone       String // CRITICAL: Used for WhatsApp integration
  email       String?
  address     String?
  isActive    Boolean @default(true) // Soft delete

  products Product[] // M:1: Products supplied by this company
  expenses Expense[] // Expenses paid to this supplier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Manage central product catalog and financial pricing
model Product {
  id      Int     @id @default(autoincrement())
  sku     String  @unique
  barcode String? @unique

  name        String
  brand       String
  category    String
  description String?

  // 🛡️ MOTOR FINANCIERO ERP
  costPrice      Decimal? @db.Decimal(14, 4) // Costo del Proveedor (Sin IVA)
  profitMargin   Decimal  @default(30.0) @db.Decimal(7, 4) // Margen de Ganancia (%)
  ivaPercentage  Decimal  @default(21.0) @db.Decimal(7, 4) // Impuesto (%)
  retailPrice    Decimal? @db.Decimal(14, 4) // Precio Final al Público
  wholesalePrice Decimal? @db.Decimal(14, 4) // Precio Mayorista (Opcional)

  color         String?
  finish        String?
  volume        Float?
  volumeUnit    String?
  indoorOutdoor Boolean  @default(true)
  baseType      String?
  metadata      Json?
  images        String[] @default([])

  isActive Boolean @default(true)

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  stocks    Stock[]
  movements Movement[]
  saleItems SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Manage physical inventory levels per branch
model Stock {
  id       Int @id @default(autoincrement())
  quantity Int @default(0)
  minStock Int @default(5)

  // INYECCIÓN RECUPERADA: Semáforo Dinámico
  criticalStock Int @default(0)

  // The level the owner wants to keep. At or above it the product reads as
  // "Sano"; between minStock and this it is merely "Suficiente" — enough to
  // sell, not enough to relax. 0 = unset, and then "sano" is simply anything
  // above minStock, which is how it behaved before this existed.
  healthyStock Int @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
}

// Track every physical movement of goods (Audit Trail)
model Movement {
  id       Int     @id @default(autoincrement())
  type     String // IN, OUT, ADJUST
  quantity Int
  reason   String?

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([productId, branchId])
}

// ==========================================
// SHIFT & CASH REGISTER MODULE
// ==========================================
model CashRegister {
  id          Int       @id @default(autoincrement())
  openingTime DateTime  @default(now())
  closingTime DateTime? // Null means the shift is currently OPEN

  initialBalance  Decimal  @db.Decimal(14, 2) // Fondo de caja (Sencillo para dar vuelto)
  expectedBalance Decimal? @db.Decimal(14, 2) // Calculado por el sistema al cerrar
  actualBalance   Decimal? @db.Decimal(14, 2) // Contado por el empleado al cerrar
  discrepancy     Decimal? @db.Decimal(14, 2) // Diferencia (Sobrante o Faltante)

  status       String  @default("OPEN") // OPEN, CLOSED
  observations String? // Notas sobre faltantes o retiros

  /**
   * La computadora cuyo cajón se está arqueando. OBLIGATORIA.
   *
   * Pasó de nullable a requerida en el paso de CONTRACT, recién después de
   * verificar que no quedara ni un turno sin terminal y que ninguno apuntara a
   * una terminal de otra sucursal. `openShift` la resuelve siempre —y rechaza
   * la apertura si no puede—, así que todo escritor la completa.
   *
   * Un turno sin terminal es un arqueo sin cajón: no se sabe de qué caja salió
   * la plata. Por eso acá sí corresponde exigirla, a diferencia de `Sale`.
   */
  terminalId Int
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  userId Int // Empleado que abrió la caja
  user   User @relation(fields: [userId], references: [id])

  branchId Int // Sucursal donde se operó
  branch   Branch @relation(fields: [branchId], references: [id])

  sales    Sale[] // Ventas vinculadas a este turno
  payments Payment[] // Cobranzas vinculadas a este turno

  // NEW: Gastos operativos que salieron del cajón durante este turno
  expenses Expense[]

  // NEW: Movimientos de efectivo sin venta (ingreso/retiro manual del cajón)
  cashMovements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([userId])
}

// ==========================================
// CASH MOVEMENTS (Ingreso/Retiro de efectivo sin venta)
// ==========================================
// Physical cash added to or taken from the drawer that is NOT a sale or an
// expense — e.g. loading change at the start, or the owner withdrawing cash.
// Feeds directly into the shift's expected balance (arqueo).
model CashMovement {
  id     Int     @id @default(autoincrement())
  type   String // "IN" (ingreso) or "OUT" (retiro)
  amount Decimal @db.Decimal(14, 2)
  reason String

  cashRegisterId Int
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())

  @@index([cashRegisterId])
  @@index([branchId, createdAt])
}

// ==========================================
// NEW: EXPENSE MODULE (Gastos Operativos diarios)
// ==========================================
model Expense {
  id       Int     @id @default(autoincrement())
  amount   Decimal @db.Decimal(14, 2) // Dinero físico retirado de la caja
  reason   String // Ej: "Compra lavandina", "Pago a fletero"
  category String // Ej: "LIMPIEZA", "LOGISTICA", "OTROS"

  // INYECCIÓN RECUPERADA: Clasificación Financiera Estructural (Fijo vs Variable)
  type String @default("VARIABLE") // "FIXED" or "VARIABLE"

  // Link to the exact shift from which the money was taken
  cashRegisterId Int
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  userId Int // Employee who registered the expense
  user   User @relation(fields: [userId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  // ── Soft-void (anulación con motivo) — preserves the audit trail ──
  voidedAt   DateTime? // When the expense was annulled (null = active)
  voidReason String? // Why it was annulled
  voidedById Int? // User id who annulled it (plain ref, no relation)

  // ── Receipt image (factura/ticket) — Cloudinary URL ──
  receiptImageUrl String?

  // ── Optional link to the supplier paid ──
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // ── If generated from a recurring template (plain ref) ──
  recurringExpenseId Int?

  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([cashRegisterId])
  @@index([voidedAt])
  @@index([supplierId])
}

// ==========================================
// EXPENSE BUDGETS (Presupuestos de gastos)
// ==========================================
// Monthly spending ceiling, global (branchId/category = null) or scoped.
model ExpenseBudget {
  id        Int      @id @default(autoincrement())
  branchId  Int? // null = applies to all branches
  category  String? // null = applies to all categories (global budget)
  amount    Decimal  @db.Decimal(14, 2)
  period    String   @default("MONTHLY")
  createdAt DateTime @default(now())
  // Declara el default que la migración 20260624120000 ya creó en la base.
  updatedAt DateTime @updatedAt @default(now())

  @@unique([branchId, category])
}

// ==========================================
// RECURRING EXPENSES (Gastos recurrentes/programados)
// ==========================================
// Template that the operator can instantiate into a real expense in one click.
model RecurringExpense {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(14, 2)
  reason      String
  category    String
  type        String   @default("VARIABLE")
  frequency   String   @default("MONTHLY") // MONTHLY | WEEKLY
  branchId    Int
  supplierId  Int? // plain ref
  active      Boolean  @default(true)
  createdById Int // plain ref
  createdAt   DateTime @default(now())
  // Declara el default que la migración 20260624120000 ya creó en la base.
  updatedAt   DateTime @updatedAt @default(now())

  @@index([branchId, active])
}

// ------------------------------------------------------
// SALES, DEBT & CASH FLOW MODULE
// ------------------------------------------------------

// Generate billing tickets and track pending balances (Fiados)
model Sale {
  id            Int     @id @default(autoincrement())
  totalAmount   Decimal @db.Decimal(14, 2)
  paymentMethod String // CASH, CARD, CREDIT_ACCOUNT

  status     String  @default("PAID") // PAID, PENDING, PARTIAL
  balance    Decimal @default(0) @db.Decimal(14, 2) // Pending amount to be paid
  pickedUpBy String? // Name/ID of the person who physically took the items
  note       String? // Optional ticket note (printed on the receipt)

  // ── Card reconciliation metadata (terminal handled by a separate Posnet /
  //    MercadoPago Point — the system NEVER stores the full card number) ──
  cardBrand        String? // VISA, MASTERCARD, AMEX, CABAL, NARANJA, MAESTRO, MERCADOPAGO, OTRA
  cardLast4        String? // Last 4 digits, for matching the Posnet coupon (optional)
  cardInstallments Int? // Cuotas (1 = single payment)
  cardSurchargePct Decimal? @db.Decimal(7, 4) // Recargo % — informational, does NOT alter totalAmount
  couponNumber     String? // Posnet/terminal coupon (cupón/lote) number for reconciliation

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Link to the active shift
  cashRegisterId Int?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  items    SaleItem[]
  payments Payment[] // Link partial or full payments to this ticket
  returns  Return[] // Partial or full returns against this sale

  // Última barrera contra ventas duplicadas. El flujo normal lo resuelve
  // `IdempotencyRecord`; esta columna existe para que, aunque ese registro se
  // pierda o se purgue por error, la BASE siga rechazando el duplicado.
  // Nullable: las ventas históricas y las que llegan sin clave no la tienen.
  idempotencyKey String? @unique

  // Efectivo entregado y vuelto dado. El POS los calculaba en pantalla y los
  // DESCARTABA al confirmar: nunca llegaban al servidor, así que el arqueo no
  // podía contrastar lo que el cajero dijo haber recibido.
  // `null` = no registrado (ventas históricas, o cobros sin efectivo).
  cashReceived Decimal? @db.Decimal(14, 2)
  changeGiven  Decimal? @db.Decimal(14, 2)

  /**
   * En qué computadora se hizo la venta. Nullable durante el expand; las ventas
   * históricas se backfillean a la terminal legado de su sucursal, marcadas
   * como atribución inferida.
   */
  terminalId Int?
  terminal   Terminal? @relation(fields: [terminalId], references: [id])

  // ══════════════════════════════════════════════════════════════════════
  // ATRIBUCIÓN
  // ══════════════════════════════════════════════════════════════════════
  //
  // Hasta la Fase 5 existía UN SOLO campo de usuario (`userId`), que se
  // llenaba con el dueño del token. Eso no alcanza para nada de lo que el
  // negocio necesita saber:
  //
  //   · Quién VENDIÓ decide la comisión.
  //   · Quién COBRÓ decide de quién es el faltante en el arqueo.
  //
  // En un mostrador compartido pueden ser personas distintas, y con un solo
  // campo no había forma de distinguirlas. Ninguno de los dos se acepta del
  // navegador: salen del contexto de operador que resuelve el servidor.

  // `onDelete: Restrict` explícito, y no el `SetNull` que Prisma pondría por
  // defecto en una relación opcional. Con SetNull, borrar un usuario dejaría
  // huérfanas todas sus ventas: el historial diría que nadie las vendió y la
  // comisión ya liquidada quedaría sin dueño. Un empleado que se va no borra lo
  // que hizo. Es la misma regla que ya rige `userId`.

  // OBLIGATORIAS desde el paso de contract (migración 20260814080000). Una
  // venta sin vendedor ni cajero no es una venta a medias: es una venta que
  // nadie puede cobrar como suya ni justificar en el arqueo.

  /** Quien recibe el crédito de la venta y, en la Fase 8, la comisión. */
  sellerId Int
  seller   User @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  /** Quien recibió o registró el cobro. */
  cashierId Int
  cashier   User @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)

  /** Con qué sesión de operador se hizo. Nulo en las ventas históricas. */
  operatorSessionId Int?

  /**
   * Nombres CONGELADOS al momento de vender.
   *
   * Sin esto, renombrar a alguien —o corregirle una falta de ortografía—
   * reescribiría el historial de todas sus ventas pasadas. Un comprobante
   * emitido no cambia porque después cambie una fila de usuarios.
   */
  sellerNameSnapshot  String?
  cashierNameSnapshot String?

  /**
   * `true` = la atribución fue **inferida**, no observada.
   *
   * Las ventas anteriores a esta fase sólo tienen `userId`. El backfill copia
   * ese valor a vendedor y cajero porque es la mejor aproximación disponible,
   * pero **no es un hecho registrado**: nadie observó quién cobró. Esta bandera
   * existe para que el historial y los incentivos puedan decir la verdad sobre
   * la diferencia en vez de presentar una suposición como un dato.
   */
  attributionLegacy Boolean @default(false)

  /**
   * Qué CLASE de operación es.
   *
   * Hoy el consumo del personal es una venta ordinaria a un `Customer` de tipo
   * INTERNAL, así que se cuela en la facturación y en el ranking de vendedores.
   * Marcarlo acá permite excluirlo de los reportes ya mismo, sin esperar al
   * modelo completo de la Fase 7.
   */
  kind String @default("SALE") // SALE | INTERNAL_CONSUMPTION

  // ── Traslado al libro del personal (Fase 7) ──
  //
  // ACUMULADOS sobre todos los ciclos. El activo es la diferencia. Un ciclo
  // totalmente revertido aporta lo mismo a los dos, así que no altera el activo.
  //
  // `status` y `balance` NO se tocan: siguen diciendo lo que la venta fue.
  // La cuenta corriente vigente se calcula como
  //   GREATEST(balance - (transferredToStaffLedger - transferReversed), 0)
  // así que la venta sale de Cuentas Corrientes porque su parte quedó cubierta,
  // **no porque digamos que se pagó**.
  transferredToStaffLedger Decimal @default(0) @db.Decimal(14, 2)
  transferReversed         Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([cashRegisterId])
  @@index([userId])
  @@index([customerId])
  @@index([status])
  // Índices del historial. `Sale` tiene 41 filas en producción (medido, no
  // supuesto), así que van como índices normales dentro de la migración: la
  // regla de §4.9 reserva `CONCURRENTLY` para tablas grandes, y ésta no lo es
  // ni de cerca.
  @@index([sellerId, createdAt])
  @@index([cashierId, createdAt])
  @@index([terminalId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
}

// Record individual billing rows with frozen historical costs
model SaleItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal  @db.Decimal(14, 4) // Final price actually charged (post-discount)
  subtotal  Decimal  @db.Decimal(14, 2)
  unitCost  Decimal? @db.Decimal(14, 4) // Frozen cost snapshot
  listPrice   Decimal? @db.Decimal(14, 4) // Original list price before any discount
  discountPct Decimal? @db.Decimal(7, 4)  // Discount % applied to this line (0-100)

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// Register physical money entering the drawer (Cash Flow)
model Payment {
  id            Int     @id @default(autoincrement())
  amount        Decimal @db.Decimal(14, 2) // Physical money collected
  paymentMethod String // CASH, TRANSFER, etc.

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id])

  userId Int // Cashier who collected the money
  user   User @relation(fields: [userId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  // Link to the active shift
  cashRegisterId Int?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([cashRegisterId])
  @@index([branchId, createdAt])
}

// ==========================================
// RMA & RETURNS MODULE
// ==========================================
// Devolución de mercadería contra una venta.
model Return {
  /** Cómo se le devolvió la plata al cliente. Puede haber varias: una venta
   *  con pago mixto se reintegra parte en efectivo y parte por reversa. */
  settlements RefundSettlement[]

  id             Int      @id @default(autoincrement())
  saleId         Int
  sale           Sale     @relation(fields: [saleId], references: [id])
  reason         String
  branchId       Int
  createdById    Int
  totalRefund    Decimal  @db.Decimal(14, 2)
  // JSON snapshot: [{saleItemId, productId, quantity, refundedUnitPrice}]
  items          Json
  cashRegisterId Int?
  createdAt      DateTime @default(now())

  @@index([saleId])
  @@index([branchId])
}

// ------------------------------------------------------
// ERP OFFLINE / AUDIT / INTERNAL OPERATIONS SCAFFOLDING
// ------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId Int?
  branchId    Int?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([branchId])
  @@index([entityType, entityId])
}

model SyncOperation {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique
  branchId       Int?
  userId         Int?
  type           String
  status         String    @default("PENDING")
  payload        Json
  error          String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([branchId])
  @@index([userId])
  @@index([status])
}

model SyncCheckpoint {
  id           Int       @id @default(autoincrement())
  deviceId     String
  userId       Int
  branchId     Int?
  lastPulledAt DateTime?
  lastPushedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([deviceId, userId, branchId])
}

model StockTransfer {
  id           String   @id @default(uuid())
  productId    Int
  fromBranchId Int
  toBranchId   Int
  quantity     Int
  reason       String?
  userId       Int
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model PurchaseOrder {
  id         String   @id @default(uuid())
  supplierId Int?
  branchId   Int
  status     String   @default("DRAFT")
  items      Json
  createdBy  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([branchId])
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String?
  supplierId      Int?
  branchId        Int
  items           Json
  receivedBy      Int
  receivedAt      DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([branchId])
}

model InternalReceipt {
  id             String   @id @default(uuid())
  receiptNumber  String   @unique
  receiptType    String
  branchId       Int
  cashRegisterId Int?
  saleId         Int?
  paymentId      Int?
  payload        Json
  createdBy      Int
  createdAt      DateTime @default(now())

  @@index([branchId])
  @@index([saleId])
  @@index([paymentId])
}

// ==========================================
// PAYROLL MODULE — Employee salary management
// ==========================================

model Employee {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  position   String // e.g. "Vendedor", "Encargado"
  salaryType String   @default("FIXED") // FIXED | HOURLY | COMMISSION
  baseSalary Decimal  @db.Decimal(12, 2)
  branchId   Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payrollRecords PayrollRecord[]

  @@index([branchId])
  @@index([userId])
}

model PayrollRecord {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id])
  period       String // "YYYY-MM"
  baseSalary   Decimal   @db.Decimal(12, 2)
  advances     Decimal   @default(0) @db.Decimal(12, 2)
  bonuses      Decimal   @default(0) @db.Decimal(12, 2)
  deductions   Decimal   @default(0) @db.Decimal(12, 2)
  netPay       Decimal   @db.Decimal(12, 2)
  status       String    @default("PENDING") // PENDING | PAID
  paidAt       DateTime?
  observations String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, period])
  @@index([period])
  @@index([status])
}

// Tracks bulk price-update jobs so job status survives server restarts.
// Previously stored in-memory only (Map<string, JobState>) which lost state
// on any restart or crash.
model BulkPriceJob {
  id           String   @id @default(uuid())
  userId       Int
  filename     String
  status       String   @default("PENDING") // PENDING | PROCESSING | DONE | ERROR
  processed    Int      @default(0)
  total        Int      @default(0)
  successCount Int      @default(0)
  errorCount   Int      @default(0)
  errors       Json?    // Array of { row, sku, message } for failed rows (capped at 200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  finishedAt   DateTime?

  @@index([userId])
  @@index([status])
}

// ==========================================
// IDEMPOTENCIA
// ==========================================
// Garantiza que una operación que mueve plata, stock o saldo se ejecute
// EXACTAMENTE UNA VEZ, aunque el cliente reintente porque se le perdió la
// respuesta.
//
// Una clave sola no alcanza: hay que distinguir "es el mismo pedido de antes"
// de "alguien reusó la clave para otra cosa". Por eso van también la huella
// canónica del payload y el alcance de propiedad.
//
// Primer enum del esquema, a propósito: acá un valor mal escrito corrompe
// dinero, y el enum lo vuelve imposible en tiempo de compilación. Los modelos
// viejos siguen con String + Zod; no se migran (ruido y riesgo sin beneficio).
enum IdempotencyStatus {
  IN_FLIGHT
  COMPLETED
  FAILED
}

// ==========================================
// LIQUIDACIÓN DE REINTEGROS
// ==========================================
// Cómo se le devuelve la plata al cliente en una devolución.
//
// No todo reintegro es efectivo saliendo del cajón, y tratarlos a todos igual
// descuadra el arqueo en las dos direcciones:
//
//   · Una devolución contra deuda IMPAGA no saca un peso de la caja — sólo baja
//     lo que el cliente debe. Registrarla como salida de efectivo haría faltar
//     plata que nunca salió.
//   · Una devolución de una venta con tarjeta se reversa en el Posnet, fuera de
//     este sistema. Sacarla del cajón le quitaría efectivo real al negocio.
//
// Antes no había NADA: una devolución de venta ya pagada restauraba stock y no
// registraba ningún movimiento de dinero. El cajón esperaba más efectivo del
// que tenía y nadie sabía por qué.
// ==========================================
// TERMINALES FÍSICAS
// ==========================================
// Una terminal es la COMPUTADORA del mostrador, con su cajón de dinero.
//
// Hasta ahora el turno de caja era "uno abierto por sucursal", porque no había
// forma de nombrar la máquina. Con dos personas atendiendo en dos puestos de la
// misma sucursal, eso obliga a compartir un único turno y el arqueo deja de
// poder decir de qué cajón salió cada peso.
//
// La terminal pertenece a UNA sucursal por vez, y es la que ancla el turno.
enum TerminalStatus {
  ACTIVE
  INACTIVE
}

model Terminal {
  id       Int    @id @default(autoincrement())
  /** Código estable que el personal dice en voz alta: "893-CAJA-01". */
  code     String @unique
  name     String
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  status TerminalStatus @default(ACTIVE)

  /**
   * Secreto de dispositivo, SIEMPRE hasheado — nunca el valor en claro.
   *
   * Se entrega al enrolar y viaja en una cookie HttpOnly. El navegador no puede
   * inventarse un `deviceId`: sin este secreto no hay terminal.
   */
  deviceSecretHash String?
  /**
   * Se incrementa al revocar o re-enrolar. Invalida TODOS los secretos
   * anteriores del lado del servidor, sin depender de que el navegador borre
   * nada.
   */
  deviceSecretVersion Int @default(0)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cashRegisters CashRegister[]
  sales         Sale[]
  enrollments   TerminalEnrollment[]
  /** Quién estuvo operando esta computadora, y cuándo. */
  operatorSessions PosOperatorSession[]
  /** Carritos en curso y tickets en espera, aislados por operador. */
  drafts           PosDraft[]

  @@index([branchId, status])
}

/**
 * Token de un solo uso para enrolar una computadora.
 *
 * El admin lo emite y se muestra UNA vez; en la base va hasheado. Sin este
 * paso, cualquiera que conozca un `terminalId` podría hacerse pasar por esa
 * caja — que es exactamente lo que el enunciado prohíbe.
 */
model TerminalEnrollment {
  id         Int      @id @default(autoincrement())
  terminalId Int
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  tokenHash  String   @unique
  issuedById Int
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([terminalId])
}

// ==========================================
// PIN DEL PUNTO DE VENTA
// ==========================================
// Cada persona que vende tiene su PIN — incluido el dueño. Sin eso, el cambio
// rápido de operador no sirve: las ventas del dueño quedarían atribuidas a
// quien abrió el navegador.
model PosPinCredential {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id])

  /**
   * Hash Argon2id CON PEPPER. El pepper vive fuera de la base, así que un
   * volcado de esta tabla no permite verificar ni un solo PIN.
   */
  pinHash String

  /**
   * Forma REVERSIBLE, para que cada uno pueda ver su propio PIN.
   *
   * Es el riesgo que el negocio aceptó a conciencia: quien obtenga la clave AES
   * y un volcado de la base recupera todos los PIN. Se mitiga con clave fuera
   * de la base, separada del pepper y versionada para poder rotar.
   *
   * Nullable: si el sistema está en modo degradado (sin clave), el PIN se puede
   * seguir VALIDANDO por el hash aunque no se pueda revelar.
   */
  pinCipher  Bytes?
  pinNonce   Bytes?
  pinTag     Bytes?
  keyVersion Int?

  isEnabled  Boolean @default(true)
  /** El PIN vino de una activación: hay que cambiarlo al primer uso. */
  mustChange Boolean @default(false)

  lastChangedAt DateTime  @default(now())
  lastRevealAt  DateTime?

  /** Rate limit: fallos seguidos y hasta cuándo está bloqueado. */
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Credencial de activación de un solo uso.
 *
 * **NO es un PIN.** Un encargado que resetea el PIN de otra persona recibe
 * esto, no el PIN final: así nunca puede entrar como esa persona, ni por un
 * momento. Quien lo canjea define su propio PIN.
 */
model PosPinActivation {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  codeHash   String    @unique
  issuedById Int
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ==========================================
// SESIÓN DE OPERADOR
// ==========================================
// Quién está operando la terminal AHORA — que no es necesariamente quien abrió
// el navegador.
//
// En un mostrador compartido, la sesión puede haberla iniciado el dueño y estar
// atendiendo un empleado. Si autorizáramos por el token de sesión, el empleado
// heredaría permisos de dueño. Este modelo separa las dos identidades.
enum PosSessionStatus {
  ACTIVE
  LOCKED
  CLOSED
}

/**
 * Cómo se probó la identidad del operador.
 *
 * `LEGACY_JWT` es la transición: quien todavía no configuró su PIN igual
 * necesita vender. **No es un bypass** — se crea una sesión REAL, se resuelven
 * capacidades efectivas y se audita igual que cualquier otra. Sólo que el
 * operador y el dueño del token son la misma persona por construcción, así que
 * no hay identidad que probar aparte. Queda marcada para que el historial diga
 * la verdad sobre cómo se identificó cada venta.
 */
enum PosSessionOrigin {
  PIN
  LEGACY_JWT
}

model PosOperatorSession {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  terminalId Int
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  branchId       Int
  cashRegisterId Int?

  status PosSessionStatus @default(ACTIVE)
  origin PosSessionOrigin @default(PIN)

  /** Quién tenía la sesión de cuenta abierta. Sólo para auditoría: nadie se
   *  esconde detrás del PIN de otro. */
  authenticatedActorId Int

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  lockedAt       DateTime?
  endedAt        DateTime?

  // ⚠️ Además existe un índice único PARCIAL que Prisma no sabe expresar:
  //    pos_operator_session_one_active_per_terminal → UNIQUE(terminalId) WHERE status='ACTIVE'
  // Vive en la migración. Una terminal tiene UN operador activo por vez; que
  // haya dos sería no saber a quién atribuir la venta que entra ahora.
  @@index([terminalId, status])
  @@index([userId, status])
}

// ==========================================
// BORRADORES DEL POS
// ==========================================
// El carrito deja de vivir sólo en la memoria del navegador.
//
// Hoy cambiar de operador exige cerrar sesión, y eso DESTRUYE el carrito. Con
// el borrador en el servidor, A arma su ticket, entra B con su PIN, vende, y
// cuando A vuelve encuentra lo suyo intacto. Ése es el punto entero de F10.

enum PosDraftKind {
  DRAFT // el carrito en curso: uno solo por operador y terminal
  HELD // ticket puesto en espera (F7): puede haber varios
}

model PosDraft {
  id Int @id @default(autoincrement())

  terminalId Int
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  operatorUserId Int
  operator       User @relation(fields: [operatorUserId], references: [id])

  branchId Int

  kind  PosDraftKind @default(DRAFT)
  /** Nombre que le puso el cajero al ticket en espera ("el de la escalera"). */
  label String?

  /**
   * Snapshot del carrito: líneas, cliente, notas, descuentos, pagos tentativos.
   *
   * Va en JSON a propósito, y no contradice la regla de "nada de JSON para
   * relaciones contables": un borrador NO es contabilidad. No movió stock, no
   * generó asiento, no debe plata. Al cobrar, el servidor **vuelve a leer
   * precio y costo de la base** (Fase 2) e ignora los números que traiga esto.
   * Nunca decide dinero.
   */
  payload Json

  /** Sólo para mostrar la lista de tickets en espera sin abrir cada payload. */
  itemCount   Int     @default(0)
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ⚠️ Índice único PARCIAL en la migración:
  //    pos_draft_one_current_per_operator → UNIQUE(terminalId, operatorUserId) WHERE kind='DRAFT'
  @@index([terminalId, operatorUserId, kind])
  @@index([updatedAt])
}

enum RefundSettlementKind {
  CASH // efectivo del cajón — EL ÚNICO que baja el esperado de caja
  TRANSFER // transferencia bancaria
  CARD_REVERSAL // reversa por Posnet: ocurre afuera, acá sólo se deja constancia
  CUSTOMER_DEBT_CREDIT // baja la deuda de cuenta corriente
  STAFF_LEDGER_CREDIT // baja la deuda del personal (se usa desde la Fase 7)
  PENDING_REIMBURSEMENT // reconocido, se liquida después
}

model RefundSettlement {
  id       Int    @id @default(autoincrement())
  returnId Int
  return   Return @relation(fields: [returnId], references: [id])

  kind   RefundSettlementKind
  amount Decimal              @db.Decimal(14, 2)

  // Sólo para CASH: el turno del que sale la plata y el Payment negativo que
  // lo hace visible en el arqueo.
  cashRegisterId Int?
  paymentId      Int?

  // Nº de operación bancaria o de cupón, para poder conciliar después.
  reference String?

  createdById    Int
  authorizedById Int?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([returnId])
  @@index([kind])
}

model IdempotencyRecord {
  key String @id // el Idempotency-Key que mandó el cliente

  // SHA-256 del payload canónico. Misma clave + payload distinto = conflicto,
  // no un replay: devolver el resultado viejo sería responder otra pregunta.
  fingerprint String

  // Versionado porque el alcance CAMBIA de forma entre fases:
  //   1 = (userId, branchId)                        ← hoy, sin modelo Terminal
  //   2 = (terminalId, operatorUserId, branchId)    ← desde la Fase 4
  // Cada registro se compara con la regla de SU versión, así que los viejos
  // siguen siendo interpretables sin migrar datos.
  scopeVersion Int
  scopeHash    String

  status IdempotencyStatus

  // Lease: quién es dueño del intento en curso y hasta cuándo. Sin esto, un
  // proceso que muere deja la clave bloqueada para siempre.
  attemptId   String
  lockedUntil DateTime?

  // Qué produjo la operación, para poder responder lo mismo en un reintento.
  resultType  String?
  resultId    String?
  httpStatus  Int?
  failureCode String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, lockedUntil])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════════
// FASE 7 — EL LIBRO DEL PERSONAL
// ══════════════════════════════════════════════════════════════════════════
//
// ── El problema ─────────────────────────────────────────────────────────────
//
// Hoy, cuando un empleado se lleva mercadería, se registra como una VENTA
// ordinaria a un `Customer` de tipo INTERNAL, creado escribiendo un nombre a
// mano. Eso trae tres consecuencias que nadie eligió:
//
//   1. La cuenta se puede duplicar: la misma persona con dos nombres tipeados
//      distinto son dos cuentas, y ningún saldo cierra.
//   2. Entra en la facturación, en el margen y en el ranking de vendedores.
//   3. No hay vínculo con el `User` real, así que nadie puede ver su propio
//      saldo ni descontárselo del sueldo sin hacerlo a mano.
//
// ── La regla que ordena todo este bloque ────────────────────────────────────
//
// **El libro es INMUTABLE.** Nada se edita ni se borra: todo se corrige con un
// asiento compensatorio que apunta al original. Un saldo que se puede editar no
// es un saldo, es una opinión — y acá se está hablando de plata que alguien le
// debe a su empleador.

model StaffAccount {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  /**
   * Tope opcional. `null` = sin límite.
   *
   * No frena la operación por sí solo: avisa. Que un empleado no pueda llevarse
   * un pincel un viernes a la tarde porque pasó el tope por $200 es peor
   * remedio que la enfermedad; para eso está la autorización explícita.
   */
  creditLimit Decimal? @db.Decimal(14, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries      StaffLedgerEntry[]
  legacyLinks  StaffAccountLegacyLink[]
  settlements  StaffPaymentSettlement[]
  consumptions InternalConsumption[]
}

/**
 * Tipo de asiento. El signo lo decide el TIPO, no quien lo carga.
 */
enum StaffLedgerEntryType {
  OPENING_BALANCE //   débito · saldo trasladado desde una cuenta legado
  CONSUMPTION //       débito · se llevó mercadería
  ADJUSTMENT_DEBIT //  débito · corrección a favor de la empresa, con motivo
  PAYMENT //           crédito · pagó (efectivo, transferencia, etc.)
  PAYROLL_DEDUCTION // crédito · se le descontó del sueldo
  RETURN_CREDIT //     crédito · devolvió mercadería
  TRANSFER_REVERSAL // crédito · se revirtió un traslado
  ADJUSTMENT_CREDIT // crédito · condonación o corrección, con motivo
}

model StaffLedgerEntry {
  id             Int          @id @default(autoincrement())
  staffAccountId Int
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id])

  type StaffLedgerEntryType

  /**
   * Débito y crédito separados, y **nunca los dos a la vez**.
   *
   * Un solo campo con signo invita a errores de signo que después nadie
   * encuentra: un `-500` mal tipeado como `500` cambia el saldo en $1.000 y
   * parece un asiento normal. Con dos columnas, un asiento mal armado es
   * visiblemente absurdo.
   */
  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  /** Qué originó el asiento. Sin FK: apunta a tablas distintas según el tipo. */
  sourceType String? // InternalConsumption | Sale | Return | StaffPaymentSettlement | PayrollRecord
  sourceId   Int?

  /**
   * A qué asiento corrige. **El original NUNCA se edita ni se borra.**
   * Revertir es agregar, no deshacer.
   */
  reversalOfId Int?
  reversalOf   StaffLedgerEntry?  @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversals    StaffLedgerEntry[] @relation("LedgerReversal")

  reason         String
  createdById    Int
  authorizedById Int?

  /** Detalle inmutable de apoyo (desglose por venta de un traslado, etc.). */
  metadata Json?

  createdAt DateTime @default(now())

  // ⚠️ Idempotencia: toda mutación de plata lleva su clave. Aunque el
  // `IdempotencyRecord` se perdiera, la base sigue rechazando el duplicado.
  idempotencyKey String? @unique

  @@index([staffAccountId, createdAt])
  @@index([sourceType, sourceId])
}

// ── CONSUMO INTERNO ─────────────────────────────────────────────────────────
//
// Dos cosas que hoy son indistinguibles y no tienen nada que ver entre sí:
// que un empleado se lleve un pincel para su casa, y que la empresa gaste un
// rollo de cinta para pintar su propio local. La primera genera deuda de una
// persona; la segunda es un costo del negocio y **no la debe nadie**.

enum InternalConsumptionKind {
  EMPLOYEE_PERSONAL // el empleado se lo lleva → DEBE
  COMPANY_USE //       lo usa la empresa → costo, sin deudor
}

/**
 * De dónde salió el precio. Se congela en cada operación.
 *
 * Sin esto, "¿por qué este pincel se le cargó a $3.000 y aquél a $4.200?" no
 * tiene respuesta seis meses después. El origen del precio nunca queda
 * implícito.
 */
enum InternalPricePolicy {
  RETAIL //         precio de lista
  COST //           al costo
  COST_PLUS //      costo + un %
  STAFF_DISCOUNT // lista - un %
  EXPLICIT //       precio autorizado a mano; exige motivo y autorizador
}

model InternalConsumption {
  id   Int                     @id @default(autoincrement())
  kind InternalConsumptionKind

  branchId       Int
  terminalId     Int?
  cashRegisterId Int?

  /** Sólo para EMPLOYEE_PERSONAL. En COMPANY_USE no hay deudor: es `null`. */
  staffAccountId Int?
  staffAccount   StaffAccount? @relation(fields: [staffAccountId], references: [id])

  /** Obligatorio en COMPANY_USE: para qué se usó ("pintar el depósito"). */
  purpose String?

  pricePolicy     InternalPricePolicy @default(RETAIL)
  /** El % del COST_PLUS o del STAFF_DISCOUNT. Congelado acá. */
  pricePolicyRate Decimal?            @db.Decimal(7, 4)

  totalAmount Decimal @db.Decimal(14, 2)
  /** Costo de la mercadería. Es lo que le cuesta al negocio, sepa o no venderlo. */
  totalCost   Decimal @db.Decimal(14, 2)

  createdById    Int
  authorizedById Int?
  reason         String?

  idempotencyKey String? @unique
  createdAt      DateTime @default(now())

  items InternalConsumptionItem[]

  @@index([staffAccountId, createdAt])
  @@index([branchId, createdAt])
  @@index([kind, createdAt])
}

model InternalConsumptionItem {
  id            Int                 @id @default(autoincrement())
  consumptionId Int
  consumption   InternalConsumption @relation(fields: [consumptionId], references: [id], onDelete: Cascade)

  productId Int
  quantity  Int

  /** Snapshots congelados, igual que en una venta. */
  listPrice Decimal  @db.Decimal(14, 4)
  unitPrice Decimal  @db.Decimal(14, 4)
  /** `null` = costo desconocido. **Nunca 0 por defecto** (regla de la Fase 2). */
  unitCost  Decimal? @db.Decimal(14, 4)
  subtotal  Decimal  @db.Decimal(14, 2)

  @@index([consumptionId])
  @@index([productId])
}

// ── CÓMO PAGA EL PERSONAL ───────────────────────────────────────────────────

enum StaffPaymentMethod {
  CASH //              efectivo · ÚNICO que toca la caja física
  TRANSFER //          transferencia
  PAYROLL_DEDUCTION // se le descuenta del sueldo
  MERCHANDISE_RETURN //devolvió mercadería
  WRITE_OFF //         se le condona; exige autorizador y motivo
}

model StaffPaymentSettlement {
  id             Int          @id @default(autoincrement())
  staffAccountId Int
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id])

  method StaffPaymentMethod
  amount Decimal            @db.Decimal(14, 2)

  /**
   * Sólo para CASH. Un `CashMovement` genérico habría perdido el método de
   * pago y la causalidad contable: al cerrar la caja nadie podría distinguir
   * "Fulano pagó lo que debía" de "entró plata de algún lado".
   */
  cashRegisterId Int?
  branchId       Int?
  /** Nº de operación bancaria, para poder conciliar después. */
  reference      String?
  /** Recibo al que se imputó, cuando es descuento de haberes. */
  payrollRecordId Int?

  createdById    Int
  authorizedById Int?
  reason         String?

  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([staffAccountId, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════
// TRASLADO DE CUENTAS INTERNAS LEGADO
// ══════════════════════════════════════════════════════════════════════════
//
// ── Dos errores míos que este modelo corrige ────────────────────────────────
//
// **1. No se falsifica el histórico.** Mi primera propuesta ponía `status =
// "PAID"` y `balance = 0` en las ventas legado. Eso declara COBRADA una
// operación que nunca se cobró. El estado, el saldo, los pagos y las
// devoluciones originales quedan intactos: lo que se registra es cuánto se
// TRASLADÓ, y la cuenta corriente sólo cuenta la porción no trasladada. La
// operación se muestra "Trasladada al libro del personal", nunca "Pagada".
//
// **2. Un traslado revertido se puede volver a hacer.** La segunda versión
// tenía `saleId @unique` y a la vez decía que tras una reversión total la venta
// podía re-trasladarse. Las dos cosas no pueden ser ciertas: la base habría
// rechazado el segundo registro. Con `cycleNumber`, un ciclo cerrado queda
// archivado e inmutable, y el índice parcial garantiza que nunca haya dos
// ciclos vivos a la vez.

enum LegacyLinkStatus {
  PROPOSED //  alguien propuso el vínculo; todavía no se trasladó nada
  CONFIRMED // confirmado y trasladado
  REJECTED //  se decidió que esa cuenta legado no es de esta persona
}

model StaffAccountLegacyLink {
  id             Int          @id @default(autoincrement())
  staffAccountId Int
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id])

  /**
   * Relación 1:N, no 1:1.
   *
   * El sistema viejo permitía crear cuentas INTERNAL escribiendo cualquier
   * nombre, así que la MISMA persona puede tener varias ("Juan", "Juan P.",
   * "juan perez"). Una cuenta de personal recibe varias legado; cada legado se
   * vincula a lo sumo una vez.
   *
   * **El vínculo nunca se infiere por nombre.** La pantalla de reconciliación
   * lista cada cuenta con su saldo y alguien elige explícitamente.
   */
  legacyCustomerId Int              @unique
  status           LegacyLinkStatus @default(PROPOSED)

  transferredTotal Decimal? @db.Decimal(14, 2)
  reason           String
  proposedById     Int
  confirmedById    Int?
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transfers LegacySaleTransfer[]

  // ⚠️ Índice único PARCIAL en la migración: un solo vínculo CONFIRMED por
  // cuenta legado a la vez (puede tener varios históricos).
  @@index([staffAccountId])
}

enum TransferStatus {
  ACTIVE
  PARTIALLY_REVERSED
  FULLY_REVERSED
}

model LegacySaleTransfer {
  id           Int                    @id @default(autoincrement())
  legacyLinkId Int
  legacyLink   StaffAccountLegacyLink @relation(fields: [legacyLinkId], references: [id])

  saleId Int

  /**
   * 1, 2, 3… Un traslado por ciclo.
   *
   * Un ciclo FULLY_REVERSED queda cerrado e inmutable y **deja de ocupar** el
   * índice de ciclo vivo, así que la venta puede volver a trasladarse creando
   * el ciclo siguiente. El historial conserva todos.
   */
  cycleNumber Int

  /** Se PRESERVAN. No se tocan nunca: son el histórico real de la venta. */
  originalStatus  String
  originalBalance Decimal @db.Decimal(14, 2)

  /** Trasladado en ESTE ciclo. Inmutable. */
  transferredAmount Decimal        @db.Decimal(14, 2)
  /** Revertido de ESTE ciclo. Sólo crece, y nunca supera al trasladado. */
  reversedAmount    Decimal        @default(0) @db.Decimal(14, 2)
  status            TransferStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ⚠️ Además hay un índice único PARCIAL en la migración:
  //    UNIQUE(saleId) WHERE status IN ('ACTIVE','PARTIALLY_REVERSED')
  // — un solo ciclo VIVO por venta.
  @@unique([saleId, cycleNumber])
  @@index([legacyLinkId])
}
