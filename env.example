# Rename this file to .env before running the server locally.
# On Render: add these under Environment > Environment Variables.

NODE_ENV=development
PORT=4000

# PostgreSQL — Supabase / Render Postgres / Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Base de datos SOLO para la suite de tests. Ponela en .env.test.local, que está
# en .gitignore — nunca la commitees.
#
# La suite escribe de verdad: crea sucursales, usuarios, productos y ventas.
# El guard (tests/helpers/globalSetup.ts) aborta la corrida ANTES de escribir
# nada si no se cumple todo esto:
#   · NODE_ENV === "test"
#   · TEST_DATABASE_URL definida (NO hay fallback a DATABASE_URL)
#   · el nombre de la base termina en _test
#   · no apunta al mismo host+puerto+base que DATABASE_URL
#   · el servidor confirma por SELECT current_database() que es esa base
#
# Una rama dedicada de Neon sirve perfecto, mientras la base se llame *_test.
TEST_DATABASE_URL=postgresql://user:password@host:5432/el_club_test?sslmode=require

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_long_random_secret
# Vida de la sesión. La cookie se emite DERIVADA de este valor, así que ajustarlo
# acá alcanza: no hay un segundo número que pueda quedar desfasado.
JWT_EXPIRES_IN=24h

# ── Ingreso con el código de seis dígitos ───────────────────────────────────
#
# Sin estas variables, entrar con código NO funciona. Y no falla ruidosamente:
# la pantalla de acceso simplemente no ofrece esa puerta y todo el mundo entra
# con contraseña. Si el mostrador dice que "desapareció el teclado numérico",
# empezá por acá.
#
# Son secretos SEPARADOS a propósito: compartirlos anula el beneficio de tener
# más de uno, porque una sola filtración daría verificación Y revelado juntos.
#
# (La credencial de cada terminal enrolada NO necesita variable: es un secreto
# aleatorio por máquina, guardado hasheado en la base y comparado por hash.)

# Verificación del código (Argon2id). Vive fuera de la base para que un volcado
# de la base, por sí solo, no alcance para validar ningún código.
#   openssl rand -base64 48
POS_PIN_PEPPER=replace_with_long_random_secret

# Cifrado del código para el autorrevelado (AES-256-GCM). Distinta del pepper.
# Si falta, el sistema entra en modo degradado: se sigue pudiendo VALIDAR el
# código —el mostrador no se queda sin vender— pero no crearlo ni revelarlo.
#   openssl rand -base64 32
POS_PIN_ENC_KEY=replace_with_32_byte_base64_key

# ── Cookies en despliegue cross-origin ──────────────────────────────────────
#
# El front vive en Vercel y la API en Render: son sitios distintos, y con el
# valor por defecto ("lax") las cookies de sesión y de terminal NO VIAJAN.
# En producción esto va en "none" (que además exige HTTPS, ya presente).
# En local, con todo en la misma máquina, se deja sin definir.
COOKIE_SAME_SITE=none

# First ADMIN user creation
ADMIN_ONBOARD_SECRET=replace_with_random_secret

# Allowed frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:5174

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
